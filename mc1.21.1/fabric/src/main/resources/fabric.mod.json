  "authors": [
    "Sweenus"
  ],
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.sweenus.simplyswordsmastery.fabric.SimplySwordsMasteryFabric"
    ]
  },
  "mixins": [
    "simplyswordsmastery-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": "=1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.11",
    "fzzy_config": ">=0.7.6",
    "simplyswords": ">=1.71.0-1.21.1",
    "simplytooltips": ">=0.1.5"
  }
}
